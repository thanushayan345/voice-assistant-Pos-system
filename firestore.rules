rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Only authenticated administrators (custom claim admin == true or role in ['admin', 'owner'])
    function isAuthorizedAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'owner'
      );
    }

    // Helper: Validate schema & sanitize length of system/status fields
    function isValidSystemStatus(data) {
      return data.keys().hasAll(['maintenance', 'message', 'estimatedTime', 'updatedAt', 'blocking']) &&
        data.maintenance is bool &&
        data.blocking is bool &&
        data.message is string && data.message.size() <= 500 &&
        data.estimatedTime is string && data.estimatedTime.size() <= 120 &&
        data.updatedAt is timestamp &&
        (!('features' in data) || data.features is map);
    }

    // Real-time system maintenance & feature-flag document: system/status
    match /system/status {
      // Clients may subscribe in real time via onSnapshot()
      allow get: if true;
      allow list: if false;

      // Only authorized administrators can create or update system/status
      allow create, update: if isAuthorizedAdmin() && isValidSystemStatus(request.resource.data);
      allow delete: if false;
    }

    // Deny all other Firestore documents by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
