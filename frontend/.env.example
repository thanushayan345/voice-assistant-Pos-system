# Public Firebase Web SDK Configuration (Frontend Client Only)
# Copy this file to frontend/.env and fill in values from Firebase Console -> Project Settings -> Web App.
# SECURITY WARNING: NEVER put Firebase Admin SDK credentials or service-account private keys in frontend/.env!

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
